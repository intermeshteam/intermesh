# Configuration de la pile isolée. Copier en docker/hardened.env et remplir.
#
#   cp docker/hardened.env.example docker/hardened.env
#   chmod 600 docker/hardened.env
#
# Aucune de ces variables n'a de valeur par défaut : la pile refuse de
# démarrer si l'une manque, plutôt que d'inventer un secret et de donner
# l'illusion d'un déploiement correct.
#
# Ce fichier ne doit jamais être versionné — .gitignore couvre docker/*.env.

# --- Base d'état ---------------------------------------------------------
# Générer :  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Clé de signature du Hub ---------------------------------------------
# Signe les jetons remis aux agents. La changer les invalide tous d'un coup.
# Plusieurs Hubs d'une même grappe doivent porter la MÊME valeur, sans quoi
# un jeton émis par l'un serait rejeté par l'autre.
#
# Générer :  python3 -c "import secrets; print(secrets.token_hex(32))"
INTERMESH_HUB_SECRET=

# --- Comptes de service ---------------------------------------------------
# JSON sur une seule ligne. Sans clé déclarée ici, aucun agent ne peut
# s'enregistrer : la pile impose --require-api-key, donc l'auto-déclaration
# est refusée y compris depuis localhost.
#
# Générer une clé :  python3 -c "import secrets; print('nx_live_' + secrets.token_urlsafe(24))"
#
# Exemple (remplacer les valeurs) :
# INTERMESH_API_KEYS={"nx_live_REMPLACER":{"org_id":"banque","roles":["admin","service_account"],"permissions":["admin:*"]},"nx_live_REMPLACER_AUSSI":{"org_id":"banque","roles":["worker","service_account"],"permissions":[]}}
INTERMESH_API_KEYS=

# --- Organisation ---------------------------------------------------------
# Nom de l'organisation portée par ce Hub. Les agents s'y rattachent, et
# l'isolement multi-tenant s'appuie dessus.
INTERMESH_ORG=banque
