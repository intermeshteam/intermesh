# WebSocket endpoint of the InterMesh hub the portal connects to.
#
# Defaults to ws://localhost:8765 when unset, which is what you want for local
# development against `intermesh hub`.
#
# NEXT_PUBLIC_ variables are inlined into the client bundle at build time: the
# value is visible to anyone loading the page — fine for an endpoint, and the
# reason a change here requires a rebuild, not just a restart.
#
# Use wss:// for any hub that is not on the same machine as the browser.
NEXT_PUBLIC_INTERMESH_HUB_URL=ws://localhost:8765


# --- Supabase -------------------------------------------------------------
#
# Create a project on supabase.com, then copy Project Settings → API.
# Run supabase/schema.sql once in the SQL editor before signing anyone up.
#
# Leaving these empty is supported: authentication is skipped, the Control
# Plane pages stay open, and the account screens say what is missing. That is
# a development convenience, never a deployment state.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Put your own values in .env.local, not here — this file is committed, and a
# real project URL in it would point every clone at that one project.
#
# The anon key is public by design — Row Level Security decides what a session
# may read. The service_role key is the opposite: it bypasses RLS entirely.
# Never put it here, never behind a NEXT_PUBLIC_ name, and never in anything
# the browser downloads.
