# ==============================================================================
# CONFIGURATION INTERMESH
# ==============================================================================
# Copiez ce fichier en .env et ajustez ce dont vous avez besoin. Toutes les
# valeurs ci-dessous sont les defauts du code : un fichier vide fonctionne.
#
# Les noms portaient encore le prefixe NEXUS_ herite d'avant le renommage,
# alors que le code ne lit que INTERMESH_*. Le fichier ne configurait donc
# plus rien : chaque ligne etait ignoree en silence, ce qui est pire qu'une
# erreur au demarrage.

# Chemin de base des donnees persistantes (base d'etat, cle de signature,
# cles d'API, instantanes). Par defaut : ~/.intermesh/
INTERMESH_HOME=

# --- OBSERVABILITE ET LOGS ---
# Niveau : DEBUG, INFO, WARNING, ERROR, CRITICAL
INTERMESH_LOG_LEVEL=INFO
# Format : text (developpement local) ou json (production, agregation de logs)
INTERMESH_LOG_FORMAT=text

# --- SECURITE MULTI-TENANT ---
# Autoriser par defaut les echanges entre organisations sans regle explicite.
# Laisser a false : le cloisonnement doit etre leve par un pairage declare,
# pas par un defaut permissif.
INTERMESH_ALLOW_CROSS_TENANT=false

# --- CONFIGURATION DU HUB ---
# Adresse d'ecoute. 0.0.0.0 expose le Hub sur toutes les interfaces reseau ;
# 127.0.0.1 le confine a la machine locale.
INTERMESH_BIND_IP=0.0.0.0
INTERMESH_HUB_HOST=0.0.0.0
INTERMESH_HUB_PORT=8765
# Organisation du Hub. C'est elle qui prefixe ses agents : acme/mon_agent
INTERMESH_DEFAULT_ORG=default
# Duree de validite des jetons emis aux agents, en secondes
INTERMESH_TOKEN_EXPIRY=3600

# --- SIGNATURE DES JETONS ---
# Secret dont derive la cle Ed25519 du Hub. 32 caracteres minimum ; une valeur
# plus courte fait echouer le demarrage plutot que de degrader la securite en
# silence. Si vide, le Hub lit ~/.intermesh/hub_secret ou le cree.
#
# Ce secret ne se partage jamais entre organisations : chaque Hub signe avec
# le sien et ne publie que sa cle publique.
INTERMESH_HUB_SECRET=

# --- TLS ---
# Certificat servi par le Hub en wss://. Sans lui, le Hub ecoute en clair, ce
# qui est refuse pour un pairage vers un hote distant.
INTERMESH_SSL_CERT=

# --- COMPTES DE SERVICE (CLES D'API) ---
# Le Hub ne conserve que le condensat SHA-256 d'une cle : il peut la verifier,
# jamais la reveler. Sans configuration, les comptes de service sont
# desactives — il n'existe aucun defaut devinable.
#
# Cles en ligne, au format JSON attendu par intermesh.apikeys
INTERMESH_API_KEYS=
# ...ou chemin d'un fichier les contenant. A defaut : ~/.intermesh/api_keys.json
INTERMESH_API_KEYS_FILE=

# --- LIMITES DE DEBIT ---
# Messages par seconde et par agent, puis capacite de rafale
INTERMESH_RATE_LIMIT=15.0
INTERMESH_RATE_BURST=20.0

# --- SDK AGENT ---
# Hub joint par defaut par un agent qui n'en precise pas
INTERMESH_HUB_URL=ws://localhost:8765
# Chiffrement de bout en bout actif par defaut
INTERMESH_ENCRYPT=true
# Cle d'API utilisee par le CLI pour les commandes d'administration
INTERMESH_API_KEY=

# --- DELAIS D'EXPIRATION (SECONDES) ---
INTERMESH_TIMEOUT_WHO_IS=5.0
INTERMESH_TIMEOUT_ASK=10.0
INTERMESH_TIMEOUT_SUBMIT_TASK=15.0
INTERMESH_TIMEOUT_DISCOVER=5.0
INTERMESH_TIMEOUT_ADMIN=10.0
INTERMESH_TIMEOUT_KEY_FETCH=3.0
