# ==============================================================================
# CONFIGURATION INFRASTRUCTURE INTERNATIONALE NEXUS
# ==============================================================================
# Environnement d'execution : development, testing, staging, production
NEXUS_ENV=development

# Chemin de base pour les donnees persistantes (Base SQLite, Cles JWT, Cles d'API)
# Par defaut : ~/.nexus/
NEXUS_HOME=

# --- OBSERVABILITE ET LOGS ---
# Niveau de log : DEBUG, INFO, WARNING, ERROR, CRITICAL
NEXUS_LOG_LEVEL=INFO
# Format de sortie des logs : text (developpement local) ou json (production / cloud)
NEXUS_LOG_FORMAT=text

# --- SECURITE MULTI-TENANT ---
# Autoriser par defaut les communications inter-entreprises sans regle specifique
NEXUS_ALLOW_CROSS_TENANT=false

# --- CONFIGURATION DU HUB ---
# Adresse d'ecoute (0.0.0.0 pour ecouter sur toutes les interfaces reseau)
NEXUS_HUB_HOST=0.0.0.0
# Port d'ecoute du Hub
NEXUS_HUB_PORT=8765
# Organisation par defaut du Hub
NEXUS_DEFAULT_ORG=default
# Duree de validite des tokens JWT d'authentification (en secondes)
NEXUS_TOKEN_EXPIRY=3600

# --- SÉCURITÉ ET CRYPTOGRAPHIE ---
# Cle secrete de signature JWT (Minimum 32 caracteres pour la production)
# Si vide, le Hub cherchera le fichier ~/.nexus/hub_secret ou generera une cle
NEXUS_HUB_SECRET=

# --- LIMITES DE DEBIT (RATE LIMITING) ---
# Nombre de messages autorises par seconde par agent
NEXUS_RATE_LIMIT=15.0
# Capacite maximale de rafale (burst) pour le rate limiter
NEXUS_RATE_BURST=20.0

# --- CONFIGURATION DU SDK AGENT ---
# URL du Hub auquel l'agent se connecte par defaut
NEXUS_HUB_URL=ws://localhost:8765
# Activation du chiffrement de bout en bout (E2E) par defaut (true/false)
NEXUS_ENCRYPT=true

# --- DELAIS D'EXPIRATION (TIMEOUTS EN SECONDES) ---
NEXUS_TIMEOUT_WHO_IS=5.0
NEXUS_TIMEOUT_ASK=10.0
NEXUS_TIMEOUT_SUBMIT_TASK=15.0
NEXUS_TIMEOUT_DISCOVER=5.0
NEXUS_TIMEOUT_ADMIN=10.0
NEXUS_TIMEOUT_KEY_FETCH=3.0
